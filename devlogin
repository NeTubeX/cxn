<script type="module">
// ========================================
// IMPORTS FIREBASE
// ========================================
import{initializeApp}from"firebase/app";
import{getAuth,signInWithEmailAndPassword,createUserWithEmailAndPassword}from"firebase/auth";
import{getFirestore,doc,getDoc}from"firebase/firestore";

// ========================================
// CONFIGURATION FIREBASE
// ========================================
const firebaseConfig={apiKey:"AIzaSyDX430AIfzzgfq3o8tXHwQfIptgWOZ-K8c",authDomain:"gesco-67c43.firebaseapp.com",projectId:"gesco-67c43",storageBucket:"gesco-67c43.firebasestorage.app",messagingSenderId:"333004443566",appId:"1:333004443566:web:de41f60000e418dce9023f"};
const app=initializeApp(firebaseConfig);
const auth=getAuth(app);
const db=getFirestore(app);

// ========================================
// RÉCUPÉRATION DES PARAMÈTRES URL
// ========================================
const urlParams=new URLSearchParams(window.location.search);
const ecoleId=urlParams.get("ecole")||"mon-ecole";
const schoolDisplay=ecoleId.toUpperCase().replace(/-/g," ");
document.getElementById("schoolSub").textContent="COMPLEXE SCOLAIRE "+schoolDisplay;
document.getElementById("schoolNameTitle").textContent="ÉCOLE "+schoolDisplay;
document.title="Connexion - "+schoolDisplay;

// ========================================
// VARIABLES GLOBALES
// ========================================
let tentatives=0;
let toastTimeout=null;

// ========================================
// FONCTIONS UTILITAIRES
// ========================================

// Salutation dynamique
function getSalutation() {
    const now = new Date();
    const hour = now.getHours();
    let message = "";
    if (hour >= 5 && hour < 12) message = "Bonjour, à vous ";
    else if (hour >= 12 && hour < 18) message = "Bon après-midi, à vous !";
    else if (hour >= 18 && hour < 22) message = "Bonsoir, à vous !";
    else message = "Content de vous revoir";
    return message;
}

// Effet machine à écrire
function typeWriter(element, text, speed = 90) {
    let i = 0;
    const cursor = element.querySelector('.cursor');
    const textSpan = element.querySelector('#typedText');
    
    if (!textSpan) {
        const newSpan = document.createElement('span');
        newSpan.id = 'typedText';
        element.innerHTML = '';
        element.appendChild(newSpan);
        const cursorSpan = document.createElement('span');
        cursorSpan.className = 'cursor';
        element.appendChild(cursorSpan);
    }
    
    const targetSpan = element.querySelector('#typedText');
    targetSpan.textContent = '';
    
    function type() {
        if (i < text.length) {
            targetSpan.textContent += text.charAt(i);
            i++;
            setTimeout(type, speed);
        }
    }
    type();
}

// Initialisation de la salutation
const salutationEl = document.getElementById('salutationText');
const salutationMsg = getSalutation();
salutationEl.innerHTML = `<span id="typedText"></span><span class="cursor"></span>`;
setTimeout(() => {
    typeWriter(salutationEl, salutationMsg, 90);
}, 500);

// Fonctions de génération d'emails
function genererEmailPromoteur(ecoleId){return`promoteur.${ecoleId}@gmail.com`;}
function genererEmailDirection(ecoleId){return`direction.${ecoleId}@gmail.com`;}
function genererEmailCompta(ecoleId){return`compta.${ecoleId}@gmail.com`;}

// ========================================
// SYSTEME DE TOAST (Notifications)
// ========================================
function showToast(message, type = 'info') {
    const container = document.getElementById('toastContainer');
    if (!container) return;
    
    if (toastTimeout) {
        clearTimeout(toastTimeout);
        toastTimeout = null;
    }
    
    const existingToast = container.querySelector('.toast');
    if (existingToast) {
        existingToast.classList.remove('show');
        existingToast.classList.add('hide');
        setTimeout(() => {
            existingToast.remove();
            createToast(message, type);
        }, 500);
    } else {
        createToast(message, type);
    }
}

function createToast(message, type) {
    const container = document.getElementById('toastContainer');
    const config = {
        success: { icon: '✅', title: 'Succès' },
        error: { icon: '❌', title: 'Erreur' },
        warning: { icon: '⚠️', title: 'Attention' },
        info: { icon: 'ℹ️', title: 'Information' }
    };
    const c = config[type] || config.info;
    const el = document.createElement('div');
    el.className = `toast ${type}`;
    el.innerHTML = `
        <div class="toast-icon">${c.icon}</div>
        <div class="toast-content">
            <div class="toast-title">${c.title}</div>
            <div class="toast-message">${message}</div>
        </div>
        <button class="toast-close">✕</button>
    `;
    container.appendChild(el);
    
    setTimeout(() => el.classList.add('show'), 50);
    
    el.querySelector('.toast-close').addEventListener('click', () => {
        el.classList.remove('show');
        el.classList.add('hide');
        toastTimeout = setTimeout(() => el.remove(), 500);
    });
    
    toastTimeout = setTimeout(() => {
        if (el.parentNode) {
            el.classList.remove('show');
            el.classList.add('hide');
            setTimeout(() => {
                if (el.parentNode) el.remove();
            }, 500);
        }
    }, 4000);
}

// ========================================
// CHARGEMENT DU LOGO
// ========================================
async function getSchoolLogo(ecoleId) {
    try {
        const docRef = doc(db, "ecoles", ecoleId);
        const docSnap = await getDoc(docRef);
        if (docSnap.exists()) {
            const data = docSnap.data();
            return data.logoUrl || null;
        }
        return null;
    } catch (error) {
        console.error("Erreur chargement logo:", error);
        return null;
    }
}

async function updateSchoolLogo(ecoleId) {
    const logoImg = document.getElementById('schoolLogo');
    const placeholder = document.getElementById('logoPlaceholder');
    const logoUrl = await getSchoolLogo(ecoleId);
    if (logoUrl) {
        logoImg.src = logoUrl;
        logoImg.style.display = 'block';
        placeholder.style.display = 'none';
        logoImg.onerror = function() {
            logoImg.style.display = 'none';
            placeholder.style.display = 'flex';
        };
    } else {
        logoImg.style.display = 'none';
        placeholder.style.display = 'flex';
    }
}

// ========================================
// RÉCUPÉRATION DES CODES DE L'ÉCOLE
// ========================================
async function getSchoolCodes(){
    try{
        const ref = doc(db, "ecoles", ecoleId, "settings", "data");
        let snap = await getDoc(ref);
        
        if(snap.exists()){
            const data = snap.data();
            
            if (!data.codeDirection) {
                const schoolRef = doc(db, "ecoles", ecoleId);
                const schoolSnap = await getDoc(schoolRef);
                
                if (schoolSnap.exists()) {
                    const schoolData = schoolSnap.data();
                    if (schoolData.codeDirection) {
                        data.codeDirection = schoolData.codeDirection;
                    }
                }
            }
            
            return data;
        } else {
            return null;
        }
    } catch(e){
        console.error("Erreur chargement codes:", e);
        return null;
    }
}

// ========================================
// ⭐⭐⭐ FONCTION PRINCIPALE DE CONNEXION (MODIFIÉE) ⭐⭐⭐
// ========================================
async function seConnecter(){
    const password = document.getElementById("loginPassword").value.trim();
    const btn = document.getElementById("loginBtn");
    
    // Validation de base
    if(!password || password.length < 4){
        showToast("Code d'accès incorrect. Veuillez réessayer.", "error");
        tentatives++;
        if(tentatives >= 5){
            showToast("Trop de tentatives. Veuillez contacter le support.", "error");
            document.getElementById("loginPassword").disabled = true;
        }
        return;
    }

    btn.disabled = true;
    btn.classList.add('loading');

    try{
        // 1. Récupérer les codes de l'école
        const codes = await getSchoolCodes();
        
        if(!codes){
            showToast("École non reconnue. Veuillez contacter le support.", "error");
            btn.disabled = false;
            btn.classList.remove('loading');
            return;
        }

        // 2. Vérifier le code saisi
        let role = null;
        let email = null;
        let urlDestination = '';

        const codeDir = codes.codeDirection ? codes.codeDirection.trim() : '';
        const codeCompta = codes.codeComptabilite ? codes.codeComptabilite.trim() : '';
        const codePromoteur = codes.codePromoteur ? codes.codePromoteur.trim() : '';
        const passwordClean = password.trim();

        if(codeDir === passwordClean){
            role = 'direction';
            email = codes.emailDirection || genererEmailDirection(ecoleId);
            urlDestination = 'https://www.netubex.com/schooldirection';
        } else if(codeCompta === passwordClean){
            role = 'comptabilite';
            email = codes.emailComptabilite || genererEmailCompta(ecoleId);
            urlDestination = 'https://www.netubex.com/schoolcompta';
        } else if(codePromoteur === passwordClean){
            role = 'promoteur';
            email = codes.emailPromoteur || genererEmailPromoteur(ecoleId);
            urlDestination = 'https://www.netubex.com/schoolpromo';
        } else {
            showToast("Code d'accès incorrect. Veuillez réessayer.", "error");
            tentatives++;
            btn.disabled = false;
            btn.classList.remove('loading');
            if(tentatives >= 5){
                showToast("Trop de tentatives. Veuillez contacter le support.", "error");
                document.getElementById("loginPassword").disabled = true;
            }
            return;
        }

        // 3. Authentification Firebase
        const roleLabels = { direction:'Direction', comptabilite:'Comptabilité', promoteur:'Promoteur' };
        showToast(`Vérification réussie. Connexion en tant que ${roleLabels[role]}...`, "success");

        try{
            await createUserWithEmailAndPassword(auth, email, password);
        } catch(e){
            if(e.code !== 'auth/email-already-in-use'){
                console.error("Erreur création compte:", e);
            }
        }

        try{
            await signInWithEmailAndPassword(auth, email, password);
        } catch(authError){
            if(authError.code === 'auth/user-not-found'){
                await createUserWithEmailAndPassword(auth, email, password);
                await signInWithEmailAndPassword(auth, email, password);
            } else {
                throw authError;
            }
        }

        // ========================================
        // ⭐⭐⭐ NOUVEAU : STOCKAGE DANS SESSIONSTORAGE ⭐⭐⭐
        // ========================================
        // 4. Stocker les informations de connexion dans sessionStorage
        //    Ces données seront utilisées par la page d'accueil
        //    pour charger le bon espace sans paramètres dans l'URL
        sessionStorage.setItem('ecoleId', ecoleId);
        sessionStorage.setItem('role', role);
        sessionStorage.setItem('code', password);
        sessionStorage.setItem('isAuthenticated', 'true');
        sessionStorage.setItem('loginTime', Date.now().toString()); // Pour gérer l'expiration
        
        console.log('✅ Données stockées dans sessionStorage:', {
            ecoleId: ecoleId,
            role: role,
            isAuthenticated: 'true'
        });

        // ========================================
        // ⭐⭐⭐ NOUVEAU : REDIRECTION VERS LA PAGE D'ACCUEIL ⭐⭐⭐
        // ========================================
        // 5. Rediriger vers la page d'accueil SANS paramètres
        //    L'URL deviendra : https://www.netubex.com
        //    Les paramètres ecole et code sont masqués !
        showToast(`✅ Connexion réussie ! Redirection vers l'espace ${roleLabels[role]}...`, "success");
        
        setTimeout(() => {
            // window.location.replace() remplace l'URL dans l'historique
            // L'utilisateur ne pourra pas revenir en arrière vers la page de login
            window.location.replace('https://www.netubex.com');
        }, 800);

    } catch(error){
        console.error("Erreur:", error);
        showToast("Une erreur est survenue. Veuillez contacter le support.", "error");
        btn.disabled = false;
        btn.classList.remove('loading');
    }
}

// ========================================
// ÉVÉNEMENTS
// ========================================

// Bouton de connexion
document.getElementById("loginBtn").addEventListener("click", seConnecter);

// Touche Entrée
document.getElementById("loginPassword").addEventListener("keypress", function(e){
    if(e.key === "Enter") seConnecter();
});

// Limiter à 6 caractères
document.getElementById("loginPassword").addEventListener("input", function(){
    if(this.value.length > 6) this.value = this.value.slice(0, 6);
});

// Focus automatique
document.getElementById("loginPassword").focus();

// Charger le logo
updateSchoolLogo(ecoleId);

// ========================================
// SÉCURITÉ : Bloquer les outils de développement
// ========================================

// Bloquer le clic droit
document.addEventListener('contextmenu', e => e.preventDefault());

// Bloquer F12, Ctrl+Shift+I, Ctrl+Shift+C, Ctrl+U, Ctrl+Shift+J
document.addEventListener('keydown', function(e) {
    if (e.key === 'F12' || e.keyCode === 123) {
        e.preventDefault();
        e.stopPropagation();
        return false;
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'I' || e.key === 'i' || e.keyCode === 73)) {
        e.preventDefault();
        e.stopPropagation();
        return false;
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'C' || e.key === 'c' || e.keyCode === 67)) {
        e.preventDefault();
        e.stopPropagation();
        return false;
    }
    if (e.ctrlKey && (e.key === 'U' || e.key === 'u' || e.keyCode === 85)) {
        e.preventDefault();
        e.stopPropagation();
        return false;
    }
    if (e.ctrlKey && e.shiftKey && (e.key === 'J' || e.key === 'j' || e.keyCode === 74)) {
        e.preventDefault();
        e.stopPropagation();
        return false;
    }
    return true;
});

// Bloquer le drag & drop
document.addEventListener('dragover', e => e.preventDefault());
document.addEventListener('drop', e => e.preventDefault());

// ========================================
// MESSAGE D'INFORMATION POUR LE DÉVELOPPEUR
// ========================================
console.log('✅ Page de connexion chargée avec succès');
console.log('📌 URL actuelle :', window.location.href);
console.log('📌 École :', ecoleId);
console.log('💡 Après connexion réussie, redirection vers https://www.netubex.com (sans paramètres)');

</script>
